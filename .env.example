# === Survival-First Autonomous Crypto Trading Agent ===
APP_NAME="Survival Trading Agent"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# === Operating & Trading Modes ===
# Modes: BACKTEST, PAPER, TESTNET, LIVE_READ_ONLY, LIVE_TRADING
TRADING_MODE=PAPER
AUTONOMY_MODE=HYBRID
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMED=false

# === Initial Capital & Survival Risk Limits ===
INITIAL_CAPITAL_USD=1.00
QUOTE_CURRENCY=USDT
MARKET_TYPE=FUTURES
TRADING_UNIVERSE=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,DOT/USDT,LTC/USDT,NEAR/USDT,APT/USDT,ARB/USDT,OP/USDT,SUI/USDT
TIMEFRAMES=5m,15m,1h,4h

# Kelly & Risk Parameters (Centralized)
KELLY_MODE=CONSERVATIVE
KELLY_MULTIPLIER=0.10
MAX_RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.01
MAX_DRAWDOWN=0.05
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=1
MIN_VIABLE_ORDER_RATIO=0.01
MAX_SPREAD_BPS=35.0
STALE_DATA_MAX_SECONDS=120

# === Withdrawals & Profit Management ===
WITHDRAWAL_APPROVAL_REQUIRED=true
MIN_RESERVE_CAPITAL_USD=1.00
WITHDRAWAL_THRESHOLD_USD=10.00
PROFIT_ALLOCATION_PCT=0.50

# === Database ===
# Production: postgresql+asyncpg://survival:survival_pass@postgres:5432/survival_agent
# Local dev/test fallback: sqlite+aiosqlite:///./survival_agent.db
DATABASE_URL=sqlite+aiosqlite:///./survival_agent.db
DATABASE_SYNC_URL=sqlite:///./survival_agent.db

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# === Exchange Configuration (Read-only/Paper by default; NEVER commit live secrets) ===
EXCHANGE_ID=binance
EXCHANGE_SANDBOX=true
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=

# === Security & Authentication ===
# Generate a strong key in production: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_DEV_ONLY_32_BYTE_HEX_SECRET_KEY_DO_NOT_USE_IN_PROD
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
